# noctune documentation screenshot capture
#
# Copy this file to `.env.capture.local` for local use. The local file is
# gitignored and may contain secrets; this example file must never contain
# real credentials.

# Direct (unpooled) connection string for the empty, disposable Neon database
# used only to seed deterministic synthetic data for documentation screenshots.
# The capture runner will expose this to the spawned noctune Core process as
# `DATABASE_URL`. Never point this at a development or production database.
CAPTURE_DATABASE_URL=""

# Before use, the credential-free fingerprint for CAPTURE_DATABASE_URL must be
# independently reviewed and committed to `capture/database-allowlist.json`.
# This prevents the target-bound guard below from authorizing an arbitrary
# PostgreSQL database.

# Required target-bound safety guard. The runner refuses to migrate or seed
# unless this value is `noctune-docs-capture:<host>:<port>/<database>` for the
# exact CAPTURE_DATABASE_URL above. On a mismatch, it prints the required
# credential-free value.
CAPTURE_DATABASE_GUARD=""

# HTTP loopback URL where Playwright will reach noctune Core during capture.
# The runner rejects HTTPS and remote hosts, then starts the isolated local
# application here.
CAPTURE_BASE_URL="http://localhost:3100"

# Path from this repository to the noctune Core checkout that will be launched
# and photographed. The runner captures that checkout's committed HEAD (only
# scripts/seed-docs-capture.ts may be uncommitted), and reads its `.env.local`
# for DEV Supabase auth. This is the one setting that picks the product
# revision; pass the same checkout to `pnpm tutorials:capture-web`.
# Dental charts: use a checkout with Core's dental charting follow-up and the
# docs capture dental seed (`develop` once both have merged), with its Git LFS
# recordings pulled: git lfs pull --include "scripts/dental-samples/recordings/*"
CAPTURE_CORE_DIR="../noctune-core"

# Supabase is used only for authentication. Local capture will reuse the DEV
# Supabase settings already stored in noctune Core's `.env.local`, so those
# credentials should not be duplicated here.

# Synthetic, non-admin identity reserved for documentation captures. The
# capture runner generates a new ephemeral password on every run and never
# writes that password to disk.
DOCS_CAPTURE_USER_EMAIL="docs-capture@test.noctune.local"

# Freeze browser and fixture time so screenshots do not drift from day to day.
DOCS_CAPTURE_NOW="2026-07-15T17:00:00.000Z"
