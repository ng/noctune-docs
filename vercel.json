{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": true,
      "preview/**": true,
      "**": false
    }
  },
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(glob,exclude)*.md' ':!tests' ':!*.test.*' ':!*.spec.*' ':!.github' ':!.claude' ':!.codex' ':!.serena' ':!renovate.json' ':!.husky'"
}
